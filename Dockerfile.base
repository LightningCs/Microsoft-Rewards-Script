# Dockerfile.base
FROM node:24-slim

# 原始脚本中的环境变量，保持不变
ENV PLAYWRIGHT_BROWSERS_PATH=0 \
    NODE_ENV=production \
    TZ=UTC \
    FORCE_HEADLESS=1 \
    NODE_OPTIONS=--disable-warning=ExperimentalWarning

# 为 apt 配置代理并增加重试
RUN echo 'Acquire::http::Proxy "http://172.17.112.1:10090";' > /etc/apt/apt.conf.d/90proxy && \
    echo 'Acquire::https::Proxy "http://172.17.112.1:10090";' >> /etc/apt/apt.conf.d/90proxy && \
    echo 'Acquire::Retries "5";' >> /etc/apt/apt.conf.d/90proxy && \
    echo 'Acquire::http::Timeout "30";' >> /etc/apt/apt.conf.d/90proxy && \
    echo 'Acquire::https::Timeout "30";' >> /etc/apt/apt.conf.d/90proxy && \
    apt-get update && apt-get install -y --no-install-recommends \
    cron gettext-base jq tzdata ca-certificates \
    libglib2.0-0 libdbus-1-3 libexpat1 libfontconfig1 libgtk-3-0 \
    libnspr4 libnss3 libasound2 libflac12 libatk1.0-0 libatspi2.0-0 \
    libdrm2 libgbm1 libdav1d6 libx11-6 libx11-xcb1 libxcomposite1 \
    libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxrandr2 \
    libxrender1 libxss1 libxtst6 libdouble-conversion3 \
    fonts-liberation fonts-noto-core fonts-noto-color-emoji \
    fonts-freefont-ttf fonts-droid-fallback \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# 2. 设置工作目录，并安装运行时依赖 (原始脚本的 npm ci --omit=dev 部分)
WORKDIR /usr/src/microsoft-rewards-script
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

# 3. 安装浏览器到 node_modules 内部 (原始脚本的 patchright install 部分)
#    这是基础镜像构建中最耗时的一步，但只会发生一次
ENV PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
RUN npx patchright install --only-shell chromium

# 可选：清理，减小镜像体积
RUN npm cache clean --force && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# 执行以下命令来构建基础镜像
# docker build -f Dockerfile.base \
#   --build-arg PATCHRIGHT_VERSION=1.61.1 \
#   --build-arg HTTP_PROXY=http://172.17.112.1:10090 \
#   --build-arg HTTPS_PROXY=http://172.17.112.1:10090 \
#   -t ghcr.io/thenetsky/microsoft-rewards-script:base .